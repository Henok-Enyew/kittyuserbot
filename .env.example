# Copy this file to .env and fill it in. .env is git-ignored: never commit it.
# Format: NAME=value  (no quotes, no spaces around =)

# --- Required -----------------------------------------------------------------
# my.telegram.org -> API Development Tools
APP_ID=
API_HASH=
# python3 stringsetup.py  (QR login)
STRING_SESSION=
# @BotFather -> /newbot or /token
TG_BOT_TOKEN=
# Postgres URL, e.g. Supabase -> Connect -> Session pooler
DATABASE_URL=
# your Telegram user id
OWNER_ID=

# --- Basics -------------------------------------------------------------------
TZ=Africa/Addis_Ababa
COMMAND_HAND_LER=.
SUDO_COMMAND_HAND_LER=!
ALIVE_NAME=
# private group for logs/reminders (-100...), 0 = none
PRIVATE_GROUP_BOT_API_ID=0
LEETCODE_USERNAME=

# --- Optional API keys (features using them stay off without a key) ------------
AI_PROVIDER=
AI_MODEL=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GIPHY_API_KEY=
KLIPY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
API_FOOTBALL_KEY=
FOOTBALL_DATA_API_KEY=
OPEN_WEATHER_MAP_APPID=
GENIUS_API_TOKEN=
PORTFOLIO_RESUME_URL=
PORTFOLIO_AUTO_GREET=false
